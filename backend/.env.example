# 复制为 .env 后按实际环境修改；.env 已在 .gitignore 中，不要提交

# MySQL 连接串：建议为本项目单独建库和账号，不要用 root
DATABASE_URL=mysql+pymysql://etymomind:请改成你的密码@127.0.0.1:3306/etymomind?charset=utf8mb4

# JWT 签名密钥，至少 32 位随机串。生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=请替换为随机生成的长字符串

# 调试模式开启后可访问 http://127.0.0.1:8000/api/docs 接口文档
DEBUG=true

# 生产环境（HTTPS）必须设为 true，refresh token Cookie 只走 HTTPS
COOKIE_SECURE=false

# 前端走 Vite 代理时同源，无需修改；直接跨域访问时填前端地址，逗号分隔
CORS_ORIGINS=http://localhost:5173

# 关闭后只能由已有账号使用（第一个注册的用户是管理员）
ALLOW_REGISTRATION=true

DEFAULT_TIMEZONE=Asia/Shanghai
